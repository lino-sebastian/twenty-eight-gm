{
  "name": "twenty-eight-gm",
  "version": "0.1.0",
  "private": true,
  "description": "Multiplayer web app for the Indian card game 28",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"vite --mode https\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --mode https",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev:http": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"vite\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@babel/runtime": "^8.1.2",
    "@letele/playing-cards": "^0.1.0",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
